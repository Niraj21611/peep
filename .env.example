# Environment variables template for Personal Finance Tracker

# MongoDB connection string for Prisma
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/finance-tracker?retryWrites=true&w=majority"

# HTTP-only Session Auth Secret key
SESSION_SECRET="your-super-secret-session-key-at-least-32-chars-long"

# Application Environment
NODE_ENV="development"
